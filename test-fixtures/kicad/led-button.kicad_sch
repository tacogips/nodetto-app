(kicad_sch (version 20231120) (uuid root)
 (lib_symbols
  (symbol "Device:Battery" (symbol "Battery_0_1" (pin passive line (at 0 0 0) (name "+") (number "1")) (pin passive line (at 10 0 0) (name "-") (number "2"))))
  (symbol "Device:LED" (symbol "LED_0_1" (pin passive line (at 0 0 0) (name "K") (number "1")) (pin passive line (at 10 0 0) (name "A") (number "2"))))
  (symbol "Device:R" (symbol "R_0_1" (pin passive line (at 0 0 0) (name "~") (number "1")) (pin passive line (at -10 0 0) (name "~") (number "2"))))
  (symbol "Switch:SW_Push" (symbol "SW_Push_0_1" (pin passive line (at 0 0 0) (name "1") (number "1")) (pin passive line (at 0 -10 0) (name "2") (number "2"))))
  (symbol "power:+5V" (power) (symbol "+5V_0_1" (pin power_in line (at 0 0 0) (name "+5V") (number "1"))))
  (symbol "power:GND" (power) (symbol "GND_0_1" (pin power_in line (at 0 0 0) (name "GND") (number "1"))))
  (symbol "power:PWR_FLAG" (power) (symbol "PWR_FLAG_0_1" (pin power_out line (at 0 0 0) (name "PWR_FLAG") (number "1"))))
 )
 (wire (pts (xy 0 0) (xy 0 -20) (xy 20 -10)))
 (wire (pts (xy 30 10) (xy 10 0)))
 (label "SW_OUT" (at 20 0 0))
 (junction (at 20 0))
 (symbol (lib_id "Device:Battery") (at 0 0 0) (property "Reference" "BT1") (property "Value" "5V") (instances (project "fixture" (path "/root" (reference "BT1") (unit 1)))))
 (symbol (lib_id "Switch:SW_Push") (at 20 -10 0) (property "Reference" "SW1") (property "Value" "PUSH") (instances (project "fixture" (path "/root" (reference "SW1") (unit 1)))))
 (symbol (lib_id "Device:R") (at 20 0 90) (property "Reference" "R1") (property "Value" "220") (instances (project "fixture" (path "/root" (reference "R1") (unit 1)))))
 (symbol (lib_id "Device:LED") (at 30 10 0) (mirror y) (property "Reference" "D1") (property "Value" "red") (instances (project "fixture" (path "/root" (reference "D1") (unit 1)))))
 (symbol (lib_id "power:+5V") (at 0 0 0) (property "Reference" "#PWR01") (property "Value" "+5V"))
 (symbol (lib_id "power:GND") (at 10 0 0) (property "Reference" "#PWR02") (property "Value" "GND"))
 (symbol (lib_id "power:PWR_FLAG") (at 0 0 0) (property "Reference" "#FLG01") (property "Value" "PWR_FLAG"))
)
