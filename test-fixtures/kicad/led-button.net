(export
  (version "E")
  (components
    (comp (ref BT1) (value 5V) (libsource (lib Device) (part Battery)))
    (comp (ref D1) (value red) (libsource (lib Device) (part LED)))
    (comp (ref R1) (value 220) (libsource (lib Device) (part R)))
    (comp (ref SW1) (value PUSH) (libsource (lib Switch) (part SW_Push))))
  (libparts
    (libpart (lib Device) (part Battery) (pins (pin (num 1) (name +)) (pin (num 2) (name -))))
    (libpart (lib Device) (part LED) (pins (pin (num 1) (name K)) (pin (num 2) (name A))))
    (libpart (lib Device) (part R) (pins (pin (num 1) (name ~)) (pin (num 2) (name ~))))
    (libpart (lib Switch) (part SW_Push) (pins (pin (num 1) (name 1)) (pin (num 2) (name 2))))
  )
  (nets
    (net (name +5V) (node (ref BT1) (pin 1)) (node (ref SW1) (pin 1)))
    (net (name SW_OUT) (node (ref SW1) (pin 2)) (node (ref R1) (pin 1)))
    (net (name LED_A) (node (ref R1) (pin 2)) (node (ref D1) (pin 2)))
    (net (name GND) (node (ref D1) (pin 1)) (node (ref BT1) (pin 2)))
  ))
