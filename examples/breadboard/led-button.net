(export (version "E")
  (design (source "LED and button") (tool "nodetto"))
  (components
    (comp (ref "BT1") (value "5V") (footprint "nodetto:Battery_P2.54")
      (libsource (lib "nodetto") (part "Battery") (description "Battery")))
    (comp (ref "D1") (value "red") (footprint "nodetto:LED_P1")
      (libsource (lib "nodetto") (part "LED") (description "LED red")))
    (comp (ref "R1") (value "220") (footprint "nodetto:Resistor_P4")
      (libsource (lib "nodetto") (part "Resistor") (description "Resistor 5%")))
    (comp (ref "SW1") (value "PUSH") (footprint "nodetto:PushButton_P2.54x5.08")
      (libsource (lib "nodetto") (part "PushButton") (description "Push button")))
  )
  (nets
    (net (code "1") (name "VCC")
      (node (ref "BT1") (pin "1") (pinfunction "+"))
      (node (ref "SW1") (pin "1") (pinfunction "1"))
      (node (ref "SW1") (pin "2") (pinfunction "2")))
    (net (code "2") (name "GND")
      (node (ref "BT1") (pin "2") (pinfunction "-"))
      (node (ref "D1") (pin "2") (pinfunction "K")))
    (net (code "3") (name "N_D1_1")
      (node (ref "D1") (pin "1") (pinfunction "A"))
      (node (ref "R1") (pin "2") (pinfunction "2")))
    (net (code "4") (name "N_R1_1")
      (node (ref "R1") (pin "1") (pinfunction "1"))
      (node (ref "SW1") (pin "3") (pinfunction "3"))
      (node (ref "SW1") (pin "4") (pinfunction "4")))
  )
)
