(export (version "E")
  (design (source "LED and switch") (tool "nodetto"))
  (components
    (comp (ref "BT1") (value "9V") (footprint "")
      (libsource (lib "nodetto") (part "Battery") (description "Battery")))
    (comp (ref "C1") (value "100n") (footprint "")
      (libsource (lib "nodetto") (part "Capacitor") (description "Capacitor")))
    (comp (ref "D1") (value "LED") (footprint "")
      (libsource (lib "nodetto") (part "LED") (description "LED")))
    (comp (ref "R1") (value "470") (footprint "")
      (libsource (lib "nodetto") (part "Resistor") (description "Resistor")))
    (comp (ref "SW1") (value "toggle") (footprint "")
      (libsource (lib "nodetto") (part "SW_Push") (description "SW_Push")))
  )
  (nets
    (net (code "1") (name "VCC")
      (node (ref "BT1") (pin "1") (pinfunction "+"))
      (node (ref "SW1") (pin "1") (pinfunction "1")))
    (net (code "2") (name "GND")
      (node (ref "BT1") (pin "2") (pinfunction "-"))
      (node (ref "C1") (pin "2") (pinfunction "2"))
      (node (ref "D1") (pin "2") (pinfunction "K")))
    (net (code "3") (name "SW_OUT")
      (node (ref "C1") (pin "1") (pinfunction "1"))
      (node (ref "R1") (pin "1") (pinfunction "1"))
      (node (ref "SW1") (pin "2") (pinfunction "2")))
    (net (code "4") (name "N_R1_2")
      (node (ref "D1") (pin "1") (pinfunction "A"))
      (node (ref "R1") (pin "2") (pinfunction "2")))
  )
)
